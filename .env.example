# Copy to .env and fill in. .env is not committed.

# The database's password. Pick a long random one.
POSTGRES_PASSWORD=

# Sent on every outbound request. Name yourself and a way to reach you.
LODESTAR_USER_AGENT=lodestar/0.1 (operator: you; https://example.com/contact)

# Control checks: handles whose DIDs you know, which lodestar resolves
# every minute to tell its own outage from the network's. At least two
# that resolve by DNS and two by HTTPS, each on its own domain. Add a
# handle of your own. Written dns:handle=did or https:handle=did,
# comma-separated.
LODESTAR_CONTROLS=

# vps (the default) or hobbyist. A profile changes pace only.
#LODESTAR_PROFILE=vps

# Per-domain rates, as domain=checks-a-second:in-flight, comma-separated.
#LODESTAR_RATES=bsky.social=320:100

# Where the API listens on the host. There is no authentication: keep it
# on a private address.
#LODESTAR_API_BIND=127.0.0.1:8080
