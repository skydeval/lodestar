# Lodestar's public face: the status page and the read API, and nothing
# else. Compose's `caddy` service uses this file, on LODESTAR_DOMAIN with
# HTTPS, or on plain HTTP port 80 until a domain is set. A host that
# already runs a proxy sets LODESTAR_PROXY=0 and copies these rules into
# its own, with the API's and status page's host ports (127.0.0.1:8080
# and :8090 by default) in place of api:8080 and api:8090.

{$LODESTAR_DOMAIN} {
	# Caddy fetches and renews a certificate for the domain by itself. To
	# use one of your own instead (a Cloudflare Origin certificate, say),
	# put it in ./certs with a file ending .caddy that names it; see
	# docs/running.md. With no such file Caddy logs a warning and goes on.
	import /etc/caddy/certs/*.caddy

	redir / /status/ 302

	# The status page; LODESTAR_STATUS_LISTEN must be set for it.
	handle /status* {
		reverse_proxy api:8090
	}

	# The reads. `/ops/*` and the refresh request are not among them.
	@read {
		method GET HEAD
		path /account/* /accounts /handle/* /did:plc:*
	}
	handle @read {
		reverse_proxy api:8080
	}
	@batch {
		method POST
		path /accounts
	}
	handle @batch {
		reverse_proxy api:8080
	}

	respond 404
}
